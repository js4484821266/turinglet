PORT=4000
DB_PROVIDER=sqlite
SQLITE_PATH=./database/local-dev.db
POSTGRES_URL=postgres://localhost:5432/turinglet
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
PROACTIVE_POLL_MS=5000
PROACTIVE_MIN_SILENCE_MS=120000
PROACTIVE_COOLDOWN_MS=240000
USER_CONTINUATION_GRACE_MS=600
REACTIVE_RESPONSE_MAX_WAIT_MS=20000
MOCK_PROVIDER=true
LLM_PROVIDER=mock
HF_LOCAL_URL=http://127.0.0.1:8010
HF_LOCAL_TIMEOUT_MS=30000
HF_MODEL_PATH=
HF_ALLOW_MODEL_DOWNLOAD=true
HF_MODEL_CACHE_DIR=./local-llm/models
HF_MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
